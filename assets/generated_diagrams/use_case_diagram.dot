digraph UseCaseDiagram {
    rankdir=LR;
    splines=true;
    overlap=false;
    nodesep=0.4;
    ranksep=0.8;
    bgcolor="#FFFFFF";
    fontname="Helvetica,Arial,sans-serif";
    fontsize=12;

    node [fontname="Helvetica,Arial,sans-serif", fontsize=11];
    edge [fontname="Helvetica,Arial,sans-serif", fontsize=9, color="#475569"];

    // ================= ACTORS =================
    subgraph cluster_actors_left {
        rank=same;
        style=invis;

        client [
            shape=plaintext,
            label=<<table border="0" cellborder="0" cellspacing="0">
                <tr><td><font point-size="28">&#128100;</font></td></tr>
                <tr><td><b>Client</b></td></tr>
                <tr><td><font point-size="9" color="#64748b">Project Creator</font></td></tr>
            </table>>
        ];

        freelancer [
            shape=plaintext,
            label=<<table border="0" cellborder="0" cellspacing="0">
                <tr><td><font point-size="28">&#128187;</font></td></tr>
                <tr><td><b>Freelancer</b></td></tr>
                <tr><td><font point-size="9" color="#64748b">Service Provider</font></td></tr>
            </table>>
        ];
    }

    subgraph cluster_actors_right {
        rank=same;
        style=invis;

        reviewer [
            shape=plaintext,
            label=<<table border="0" cellborder="0" cellspacing="0">
                <tr><td><font point-size="28">&#9878;</font></td></tr>
                <tr><td><b>Dispute Reviewer</b></td></tr>
                <tr><td><font point-size="9" color="#64748b">Impartial Arbitrator</font></td></tr>
            </table>>
        ];

        admin [
            shape=plaintext,
            label=<<table border="0" cellborder="0" cellspacing="0">
                <tr><td><font point-size="28">&#128273;</font></td></tr>
                <tr><td><b>System Admin</b></td></tr>
                <tr><td><font point-size="9" color="#64748b">Auditor &amp; Operator</font></td></tr>
            </table>>
        ];
    }

    // ================= SYSTEM BOUNDARY =================
    subgraph cluster_system {
        label="System Boundary: Milestone Escrow & Dispute Resolution Platform (GigaFlow)";
        style="rounded,solid";
        color="#0284c7";
        penwidth=2.0;
        fillcolor="#F8FAFC";
        style="filled,rounded";
        fontname="Helvetica-Bold";
        fontsize=13;
        fontcolor="#0369a1";
        margin=20;

        node [
            shape=ellipse,
            style="filled",
            fillcolor="#FFFFFF",
            color="#0284c7",
            penwidth=1.5,
            height=0.6,
            width=2.5
        ];

        uc1 [label="UC-01: Authenticate &\nAccess Role Workspace"];
        uc2 [label="UC-02: Create Project &\nDecompose Milestones"];
        uc3 [label="UC-03: Submit Heuristic\nProposal & Bid"];
        uc4 [label="UC-04: Deposit Funds &\nLock Milestone Escrow"];
        uc5 [label="UC-05: Execute Work &\nSubmit SHA-256 Deliverable"];
        uc6 [label="UC-06: Review Deliverable &\nApprove Escrow Release"];
        uc7 [label="UC-07: Raise Dispute &\nFreeze Escrow Funds"];
        uc8 [label="UC-08: Inspect Evidence Dossier\n& Merkle Tree"];
        uc9 [label="UC-09: Render Arbitration\nRuling & Settle Ledger"];
        uc10 [label="UC-10: Audit System Journal\n& Verify Hash Chain"];

        // Extension / Included use cases
        subgraph cluster_helpers {
            style=invis;
            node [fillcolor="#EFF6FF", color="#3B82F6", style="dashed,filled", fontsize=10];
            inc_lock [label="<<include>>\nAtomic KeyedMutex Lock"];
            inc_acid [label="<<include>>\nACID Double-Entry Payout"];
            ext_timeout [label="<<extend>>\n7-Day Watchdog Auto-Release"];
        }
    }

    // ================= ASSOCIATIONS =================
    // Client associations
    client -> uc1 [color="#0284c7", penwidth=1.5];
    client -> uc2 [color="#0284c7", penwidth=1.5];
    client -> uc4 [color="#0284c7", penwidth=1.5];
    client -> uc6 [color="#0284c7", penwidth=1.5];
    client -> uc7 [color="#dc2626", penwidth=1.2, style="dashed"];

    // Freelancer associations
    freelancer -> uc1 [color="#10b981", penwidth=1.5];
    freelancer -> uc3 [color="#10b981", penwidth=1.5];
    freelancer -> uc5 [color="#10b981", penwidth=1.5];
    freelancer -> uc7 [color="#dc2626", penwidth=1.2, style="dashed"];

    // Reviewer associations
    reviewer -> uc1 [color="#8b5cf6", penwidth=1.5];
    reviewer -> uc8 [color="#8b5cf6", penwidth=1.5];
    reviewer -> uc9 [color="#8b5cf6", penwidth=1.5];

    // Admin associations
    admin -> uc1 [color="#475569", penwidth=1.5];
    admin -> uc10 [color="#475569", penwidth=1.5];

    // Includes and Extends
    uc4 -> inc_lock [style="dashed", color="#3b82f6", label="<<include>>"];
    uc6 -> inc_acid [style="dashed", color="#3b82f6", label="<<include>>"];
    uc9 -> inc_acid [style="dashed", color="#3b82f6", label="<<include>>"];
    ext_timeout -> uc6 [style="dashed", color="#eab308", label="<<extend>>"];
}
