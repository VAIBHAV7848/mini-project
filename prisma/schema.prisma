datasource db {
  provider = "postgresql"
  directUrl = env("DIRECT_URL")
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String   @map("password_hash")
  name          String
  role          String   // CLIENT | FREELANCER | REVIEWER | ADMIN
  balance       Float    @default(0.0)
  balancePaise  Int      @default(0) @map("balance_paise")
  githubProfile String?  @map("github_profile")
  devScore      Int      @default(50) @map("dev_score")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  projects              Project[]
  proposals             Proposal[]
  gigs                  Gig[]
  ordersAsClient        Order[]             @relation("ClientOrders")
  contractsAsClient     Contract[]          @relation("ClientContracts")
  contractsAsFreelancer Contract[]          @relation("FreelancerContracts")
  disputesRaised        Dispute[]           @relation("DisputesRaised")
  disputesReviewed      Dispute[]           @relation("DisputesReviewed")
  disputeEvidence       DisputeEvidence[]
  transactionsFrom      EscrowTransaction[] @relation("TransactionsFrom")
  transactionsTo        EscrowTransaction[] @relation("TransactionsTo")
  payments              Payment[]
  settlementTransfers   SettlementTransfer[]
  vendorPayoutProfile   VendorPayoutProfile?
  verifiedPayments      Payment[]            @relation("VerifiedPayments")
  processedSettlements  SettlementTransfer[] @relation("ProcessedSettlements")

  @@index([role])
  @@map("users")
}

model Project {
  id          String   @id @default(uuid())
  clientId    String   @map("client_id")
  title       String
  description String
  budget      Float
  budgetPaise Int      @default(0) @map("budget_paise")
  skillTags   String   @map("skill_tags") // JSON Array string: ["react", "node"]
  status      String   @default("OPEN")   // OPEN | IN_PROGRESS | COMPLETED | CANCELLED
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  client    User       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  proposals Proposal[]
  contract  Contract?

  @@index([clientId])
  @@index([status, createdAt(sort: Desc)])
  @@map("projects")
}

model Proposal {
  id           String   @id @default(uuid())
  projectId    String   @map("project_id")
  freelancerId String   @map("freelancer_id")
  bidAmount    Float    @map("bid_amount")
  bidAmountPaise Int    @default(0) @map("bid_amount_paise")
  coverLetter  String   @map("cover_letter")
  aiMatchScore Float    @default(0.0) @map("ai_match_score")
  status       String   @default("PENDING") // PENDING | ACCEPTED | REJECTED
  createdAt    DateTime @default(now()) @map("created_at")

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  freelancer User    @relation(fields: [freelancerId], references: [id], onDelete: Restrict)

  @@unique([projectId, freelancerId])
  @@index([projectId, aiMatchScore(sort: Desc)])
  @@map("proposals")
}

model Contract {
  id            String   @id @default(uuid())
  projectId     String   @unique @map("project_id")
  clientId      String   @map("client_id")
  freelancerId  String   @map("freelancer_id")
  totalAmount   Float    @map("total_amount")
  totalAmountPaise Int    @default(0) @map("total_amount_paise")
  escrowBalance Float    @default(0.0) @map("escrow_balance")
  escrowBalancePaise Int  @default(0) @map("escrow_balance_paise")
  status        String   @default("AWAITING_DEPOSIT") // FSM state
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  project            Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  client             User                @relation("ClientContracts", fields: [clientId], references: [id], onDelete: Restrict)
  freelancer         User                @relation("FreelancerContracts", fields: [freelancerId], references: [id], onDelete: Restrict)
  milestones         Milestone[]
  escrowTransactions EscrowTransaction[]
  payments           Payment[]
  settlementTransfers SettlementTransfer[]
  refunds            Refund[]

  @@index([clientId])
  @@index([freelancerId])
  @@index([status])
  @@map("contracts")
}

model Milestone {
  id             String    @id @default(uuid())
  contractId     String    @map("contract_id")
  title          String
  description    String
  amount         Float
  amountPaise    Int       @default(0) @map("amount_paise")
  sequenceOrder  Int       @map("sequence_order")
  status         String    @default("PENDING") // Milestone status
  dueDate        DateTime  @map("due_date")
  reviewDeadline DateTime? @map("review_deadline")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  contract           Contract            @relation(fields: [contractId], references: [id], onDelete: Restrict)
  deliverable        Deliverable?
  dispute            Dispute?
  escrowTransactions EscrowTransaction[]
  payments           Payment[]
  settlementTransfers SettlementTransfer[]
  refunds            Refund[]

  @@unique([contractId, sequenceOrder])
  @@index([contractId])
  @@index([status, reviewDeadline])
  @@map("milestones")
}

model Deliverable {
  id              String   @id @default(uuid())
  milestoneId     String   @unique @map("milestone_id")
  fileName        String   @map("file_name")
  fileUrl         String   @map("file_url")
  sha256Checksum  String   @map("sha256_checksum")
  submissionNotes String?  @map("submission_notes")
  submittedAt     DateTime @default(now()) @map("submitted_at")

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Restrict)

  @@map("deliverables")
}

model Dispute {
  id          String    @id @default(uuid())
  milestoneId String    @unique @map("milestone_id")
  raisedById  String    @map("raised_by_id")
  reviewerId  String?   @map("reviewer_id")
  reason      String
  status      String    @default("OPEN") // OPEN | UNDER_REVIEW | RESOLVED | REJECTED
  ruling      String?   // RELEASE_TO_FREELANCER | REFUND_TO_CLIENT
  rulingNotes String?   @map("ruling_notes")
  createdAt   DateTime  @default(now()) @map("created_at")
  resolvedAt  DateTime? @map("resolved_at")

  milestone     Milestone         @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  raisedBy      User              @relation("DisputesRaised", fields: [raisedById], references: [id], onDelete: Restrict)
  reviewer      User?             @relation("DisputesReviewed", fields: [reviewerId], references: [id], onDelete: Restrict)
  evidenceItems DisputeEvidence[]

  @@index([status])
  @@map("disputes")
}

model DisputeEvidence {
  id             String   @id @default(uuid())
  disputeId      String   @map("dispute_id")
  submittedById  String   @map("submitted_by_id")
  fileUrl        String   @map("file_url")
  sha256Checksum String   @map("sha256_checksum")
  description    String
  submittedAt    DateTime @default(now()) @map("submitted_at")

  dispute     Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  submittedBy User    @relation(fields: [submittedById], references: [id], onDelete: Restrict)

  @@index([disputeId])
  @@map("dispute_evidence")
}

model EscrowTransaction {
  id          String   @id @default(uuid())
  contractId  String?  @map("contract_id")
  milestoneId String?  @map("milestone_id")
  fromUserId  String?  @map("from_user_id")
  toUserId    String?  @map("to_user_id")
  amount      Float
  amountPaise Int      @default(0) @map("amount_paise")
  type        String   // DEPOSIT | LOCK | RELEASE | REFUND
  status      String   @default("COMPLETED") // PENDING | COMPLETED | FAILED
  providerPaymentId String?  @unique @map("provider_payment_id")
  createdAt   DateTime @default(now()) @map("created_at")

  contract  Contract?  @relation(fields: [contractId], references: [id], onDelete: Restrict)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  fromUser  User?      @relation("TransactionsFrom", fields: [fromUserId], references: [id], onDelete: Restrict)
  toUser    User?      @relation("TransactionsTo", fields: [toUserId], references: [id], onDelete: Restrict)

  @@index([contractId, createdAt])
  @@map("escrow_transactions")
}

model AuditLog {
  id               String   @id @default(uuid())
  actorId          String   @map("actor_id")
  entityName       String   @map("entity_name")
  entityId         String   @map("entity_id")
  action           String
  previousState    String?  @map("previous_state")
  newState         String   @map("new_state")
  prevHash         String   @default("GENESIS") @map("prev_hash")
  verificationHash String   @map("verification_hash")
  timestamp        DateTime @default(now())

  @@index([entityName, entityId])
  @@index([timestamp(sort: Desc)])
  @@map("audit_logs")
}

model Gig {
  id           String   @id @default(uuid())
  freelancerId String   @map("freelancer_id")
  title        String
  description  String
  category     String
  tiers        String   // JSON string: Basic, Standard, Premium
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  freelancer User    @relation(fields: [freelancerId], references: [id], onDelete: Restrict)
  orders     Order[]

  @@index([category])
  @@map("gigs")
}

model Order {
  id        String   @id @default(uuid())
  gigId     String   @map("gig_id")
  clientId  String   @map("client_id")
  tierName  String   @map("tier_name")
  amount    Float
  status    String   @default("PENDING")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  gig    Gig  @relation(fields: [gigId], references: [id], onDelete: Restrict)
  client User @relation("ClientOrders", fields: [clientId], references: [id], onDelete: Restrict)

  @@map("orders")
}

// ============================================================
// PAYMENT GATEWAY MODELS (Cashfree Integration)
// ============================================================

model Payment {
  id                String    @id @default(uuid())
  paymentType       String    @default("WALLET_TOPUP") @map("payment_type") // WALLET_TOPUP | CONTRACT_ESCROW
  contractId        String?   @map("contract_id")
  milestoneId       String?   @map("milestone_id")
  clientId          String    @map("client_id")
  amountPaise       Int       @map("amount_paise")
  currency          String    @default("INR")
  provider          String    @default("UPI") // UPI | CASHFREE
  providerOrderId   String?   @unique @map("provider_order_id")
  providerPaymentId String?   @map("provider_payment_id")
  status            String    @default("PENDING") // PENDING | PENDING_REVIEW | SUCCESS | FAILED | EXPIRED
  paymentSessionId  String?   @map("payment_session_id")
  idempotencyKey    String?   @unique @map("idempotency_key")

  // UPI Specific Fields
  upiOrderId        String?   @unique @map("upi_order_id")
  upiVpa            String?   @map("upi_vpa")
  upiUtr            String?   @unique @map("upi_utr")
  upiUri            String?   @map("upi_uri")
  qrPayload         String?   @map("qr_payload")

  // Verification & Audit Metadata
  verifiedByAdminId String?   @map("verified_by_admin_id")
  adminNotes        String?   @map("admin_notes")
  settledAt         DateTime? @map("settled_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  contract          Contract? @relation(fields: [contractId], references: [id], onDelete: Restrict)
  milestone         Milestone? @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  client            User      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  verifiedByAdmin   User?     @relation("VerifiedPayments", fields: [verifiedByAdminId], references: [id], onDelete: Restrict)
  events            PaymentEvent[]
  refunds           Refund[]

  @@index([contractId])
  @@index([milestoneId])
  @@index([clientId])
  @@index([status])
  @@index([upiUtr])
  @@map("payments")
}

model PaymentEvent {
  id              String   @id @default(uuid())
  paymentId       String   @map("payment_id")
  eventType       String   @map("event_type")
  providerEventId String?  @map("provider_event_id")
  rawPayload      String   @map("raw_payload")
  status          String
  createdAt       DateTime @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("payment_events")
}

model WebhookLog {
  id        String   @id @default(uuid())
  provider  String
  eventType String   @map("event_type")
  payload   String
  signature String?
  isValid   Boolean  @default(false) @map("is_valid")
  processed Boolean  @default(false)
  error     String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([provider, createdAt])
  @@map("webhook_logs")
}

model SettlementTransfer {
  id                  String    @id @default(uuid())
  contractId          String    @map("contract_id")
  milestoneId         String    @map("milestone_id")
  freelancerId        String    @map("freelancer_id")
  beneficiaryId       String    @map("beneficiary_id")
  payoutMode          String    @default("MANUAL_UPI") @map("payout_mode") // MANUAL_UPI | MANUAL_IMPS | CASHFREE
  gatewayTransferId   String?   @unique @map("gateway_transfer_id")
  idempotencyKey      String    @unique @map("idempotency_key")
  grossAmountPaise    Int       @map("gross_amount_paise")
  platformFeePaise    Int       @map("platform_fee_paise")
  netDisbursedPaise   Int       @map("net_disbursed_paise")
  currency            String    @default("INR")
  status              String    @default("PENDING") // PENDING | SUCCESS | FAILED
  failureCode         String?   @map("failure_code")
  failureReason       String?   @map("failure_reason")
  retryCount          Int       @default(0) @map("retry_count")
  nextRetryAt         DateTime? @map("next_retry_at")
  processedByAdminId  String?   @map("processed_by_admin_id")
  adminNotes          String?   @map("admin_notes")
  createdAt           DateTime  @default(now()) @map("created_at")
  settledAt           DateTime? @map("settled_at")

  contract         Contract  @relation(fields: [contractId], references: [id], onDelete: Restrict)
  milestone        Milestone @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  freelancer       User      @relation(fields: [freelancerId], references: [id], onDelete: Restrict)
  processedByAdmin User?     @relation("ProcessedSettlements", fields: [processedByAdminId], references: [id], onDelete: Restrict)

  @@index([contractId])
  @@index([freelancerId])
  @@index([status])
  @@index([gatewayTransferId])
  @@map("settlement_transfers")
}

model Refund {
  id               String   @id @default(uuid())
  paymentId        String   @map("payment_id")
  contractId       String   @map("contract_id")
  milestoneId      String?  @map("milestone_id")
  amountPaise      Int      @map("amount_paise")
  providerRefundId String?  @unique @map("provider_refund_id")
  reason           String?
  status           String   @default("PENDING") // PENDING | SUCCESS | FAILED
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  payment   Payment    @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  contract  Contract   @relation(fields: [contractId], references: [id], onDelete: Restrict)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([contractId])
  @@map("refunds")
}

model PaymentReconciliation {
  id                  String   @id @default(uuid())
  periodStart         DateTime @map("period_start")
  periodEnd           DateTime @map("period_end")
  totalCollectedPaise Int      @map("total_collected_paise")
  totalSettledPaise   Int      @map("total_settled_paise")
  totalRefundedPaise  Int      @map("total_refunded_paise")
  discrepancyPaise    Int      @default(0) @map("discrepancy_paise")
  status              String   @default("PENDING") // PENDING | RECONCILED | DISCREPANCY
  metadata            String?  // JSON
  createdAt           DateTime @default(now()) @map("created_at")

  @@map("payment_reconciliations")
}

model IdempotencyRecord {
  key          String   @id
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id")
  responseHash String?  @map("response_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  expiresAt    DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("idempotency_records")
}

model VendorPayoutProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique @map("user_id")
  vpa                 String?  // UPI Virtual Payment Address
  accountNumberMasked String?  @map("account_number_masked")
  ifsc                String?
  beneficiaryId       String?  @unique @map("beneficiary_id")
  status              String   @default("PENDING") // PENDING | VERIFIED | FAILED
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("vendor_payout_profiles")
}
