#!/usr/bin/env bash
set -euo pipefail

# ==============================================================================
# scripts/lint - Real Repository Linting & Shell Validation
# ==============================================================================

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
echo "==> Running repository lint checks in: ${PROJECT_ROOT}"

ERRORS=0

# 1. Shell Script Syntax Check
echo "--> Validating shell scripts with bash -n..."
for script in "${PROJECT_ROOT}/scripts"/*; do
  if [ -f "$script" ]; then
    case "$script" in
      *.ts|*.js|*.json|*.md|*.py)
        continue
        ;;
    esac
    if ! bash -n "$script"; then
      echo "  [FAIL] Shell syntax error in: $script"
      ERRORS=$((ERRORS + 1))
    else
      echo "  [PASS] Shell syntax OK: $(basename "$script")"
    fi
  fi
done

# 2. Check for Trailing Whitespace in Tracked / Staged Files
echo "--> Checking for trailing whitespace in project files..."
TRAILING_WS=$(git -C "${PROJECT_ROOT}" grep -I -n -E "[[:space:]]+$" -- ':!*.lock' ':!*.zip' ':!*.png' 2>/dev/null || true)
if [ -n "$TRAILING_WS" ]; then
  echo "  [FAIL] Trailing whitespace detected:"
  echo "$TRAILING_WS" | head -n 10
  ERRORS=$((ERRORS + 1))
else
  echo "  [PASS] No trailing whitespace found."
fi

# 3. Check for Non-Executable Scripts in scripts/
echo "--> Checking scripts execution bit..."
for script in "${PROJECT_ROOT}/scripts"/*; do
  if [ -f "$script" ]; then
    case "$script" in
      *.ts|*.js|*.json|*.md|*.py)
        continue
        ;;
    esac
    if [ ! -x "$script" ]; then
      echo "  [FAIL] Script is not executable: $script"
      ERRORS=$((ERRORS + 1))
    fi
  fi
done

if [ "$ERRORS" -gt 0 ]; then
  echo "==> Lint failed with $ERRORS error(s)."
  exit 1
fi

echo "==> All lint checks passed."
exit 0
